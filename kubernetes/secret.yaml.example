apiVersion: v1
kind: Secret
metadata:
  name: houserent-secret
  namespace: houserent
  labels:
    app: houserent
type: Opaque
data:
  # Base64 encoded value of your secret key:
  # On Linux/macOS: echo -n "your-secure-secret-key-2026" | base64
  # On Windows PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-secure-secret-key-2026"))
  # Example below is base64 for: "k8s-production-super-secret-key-2026"
  SECRET_KEY: azhzLXByb2R1Y3Rpb24tc3VwZXItc2VjcmV0LWtleS0yMDI2
