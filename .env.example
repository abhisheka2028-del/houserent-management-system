# ==============================================================================
# HouseRent Environment Configuration Example
# Copy this file to .env and adjust variables for your target deployment
# ==============================================================================

# Application environment: development | production | testing
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0

# Secret key for secure session cookie signing and CSRF tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-replace-in-env

# SQLite database file path
DATABASE_PATH=database/houserent.db

# Storage path for property image uploads
UPLOAD_FOLDER=static/uploads

# HTTP server port (Render assigns this dynamically in cloud environments)
PORT=5000

# Set to true in production behind HTTPS (Render provides HTTPS by default)
SESSION_COOKIE_SECURE=false

# Auto-seed sample demo data on first boot if database is newly initialized
AUTO_SEED_DATA=true

# Gunicorn worker concurrency (recommended: 2 for Render Free tier 512MB RAM)
WEB_CONCURRENCY=2

